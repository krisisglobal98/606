<?xml version="1.0" encoding="UTF-8"?>
<!--
  DOD Minimal frontend on IIS (copied into dist/ by the build; IIS site "DODMIN"). Requires the IIS URL Rewrite module
  and Application Request Routing (ARR) with "Enable proxy" on; see docs/DEPLOYMENT_WINDOWS.md and deploy/windows/.
  /api goes to the DOD Minimal API on 127.0.0.1:8181 (DOD_API_PORT), never to the full DOD installation's 8080.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 1. API: proxied to the DOD backend. First, and stops processing, so /api is never answered with index.html. -->
        <rule name="DOD API Reverse Proxy" stopProcessing="true">
          <match url="^api/(.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:8181/api/{R:1}" appendQueryString="true" />
        </rule>
        <!-- 2. SPA fallback: a client route (not a real file or folder) gets index.html, so refresh and deep links work.
                Missing build files under /assets/ stay 404 instead of returning HTML as JavaScript. -->
        <rule name="DOD SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(api|assets)/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Same policy as deploy/nginx.conf: everything from this origin only (images also data:/blob:);
         connect-src 'self': the browser calls only the DOD API on this origin. -->
    <httpProtocol>
      <customHeaders>
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <security>
      <!-- IIS default body limit (30 MB) is kept: the DOD API itself accepts at most 512 KB per request. -->
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env" />
          <add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>

  <!-- The SPA entry always revalidates, so a new deployment's chunk names are picked up on refresh. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Hashed build files never change: cache for a year. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
