# DOD Minimal configuration. Copy to `.env` and fill in (`.env` is ignored by Git; never commit real passwords).
# Only variables prefixed VITE_ reach the browser bundle; everything else is read by the DOD API (server/) only.
#
# DOD Minimal runs next to a full DOD installation on the same machine, so every default below is its own:
#   API 8181 (full DOD: 8080), Vite dev 5180 / preview 8100,
#   application database dod_application_sit (full DOD: dor_application).
# Ports opened to the public on this server: 8088-8188. DOD Minimal's public port is 8100 (web);
# 8088/8089/8090 (full DOD) and 8188 (another process) are taken. The API stays on 127.0.0.1.
# Full description of every variable: docs/CONFIGURATION.md.

# ---------------------------------------------------------------- Frontend (public, compiled into the bundle)
VITE_APP_NAME=DOD Minimal
VITE_APP_ENV=development
VITE_API_BASE_URL=/api

# ---------------------------------------------------------------- DOD API
DOD_API_HOST=127.0.0.1
DOD_API_PORT=8181
DOD_LOG_LEVEL=info
# Initial administrator, created only while the user table is empty (at least 8 characters).
DOD_ADMIN_USERNAME=admin
DOD_ADMIN_PASSWORD=
DOD_SESSION_HOURS=8
# Login throttle (per API process): attempts per client IP + username and per client IP within the window.
DOD_LOGIN_MAX_ATTEMPTS=5
DOD_LOGIN_MAX_ATTEMPTS_PER_IP=20
DOD_LOGIN_WINDOW_MINUTES=15
DOD_LOGIN_MAX_TRACKED=10000
# Reverse proxies whose X-Forwarded-For is followed (IP/CIDR, at most /8 IPv4 or /16 IPv6, or `loopback`).
# Empty = no proxy (native run, Vite dev/preview). IIS on the same server: 127.0.0.1. Never `true`.
DOD_TRUSTED_PROXIES=

# ---------------------------------------------------------------- Application database (PostgreSQL, required)
# DOD Minimal's own database: users, sessions, menu permissions, data access, connections, datasets, saved reports,
# logs. Tables are
# created by the migrations at API start. Create the database and role once: scripts/setup-local-db.ps1.
# HOST, NAME and USER have no built-in default: when empty the API refuses to start.
DOD_DB_HOST=127.0.0.1
DOD_DB_PORT=5432
DOD_DB_NAME=dod_application_sit
DOD_DB_USER=dodmin
DOD_DB_PASSWORD=
DOD_DB_SSL=false
# Optional, read-only: organization master (e.g. dor_apims_master) on the SAME server and account. Used by
# Analisis → Data Profil, and the data access scope when DOD_ORG_DB_NAME is empty (docs/DATA_ACCESS.md). Empty = Data
# Profil off.
DOD_DB_MASTER_NAME=

# ---------------------------------------------------------------- External data warehouse sources (read-only)
# The ONLY place where source connections are set: DOD Minimal has no page or API to add, change or test them,
# and the browser never sees host, database, account or password. Comma-separated prefixes; each prefix P reads
# DOD_DW_P_* and its id is P in lower case with "-" (APIMS_REPORT -> apims-report; datasets refer to that id).
# PostgreSQL/ClickHouse/MySQL need HOST, DATABASE, USERNAME and PASSWORD; without PASSWORD the connection is
# "not configured" and never dialled. Restart DOD API after a change. Use a read-only account.
DOD_DW_CONNECTIONS=
# Example: APIMS_REPORT (PostgreSQL). Uncomment, fill in, and set DOD_DW_CONNECTIONS=DEV.
# DOD_DW_DEV_NAME=APIMS REPORT DEV
# DOD_DW_DEV_ENVIRONMENT=development
# DOD_DW_DEV_TYPE=postgresql            # postgresql | clickhouse | mysql | mongodb | redis
# DOD_DW_DEV_HOST=
# DOD_DW_DEV_PORT=5432
# DOD_DW_DEV_DATABASE=APIMS_REPORT
# DOD_DW_DEV_USERNAME=
# DOD_DW_DEV_PASSWORD=
# DOD_DW_DEV_SCHEMA=public
# DOD_DW_DEV_SSL_MODE=require           # disable | require | verify-full (needs DOD_DW_DEV_SSL_ROOT_CERT)
# DOD_DW_DEV_CONNECT_TIMEOUT_MS=10000
# DOD_DW_DEV_COMMAND_TIMEOUT_MS=30000
# Default pool of every source connection (a prefix may override with DOD_DW_<P>_POOL_MIN/_MAX/_IDLE_MS).
DOD_DW_POOL_MIN=0
DOD_DW_POOL_MAX=8
DOD_DW_POOL_IDLE_MS=30000

# ---------------------------------------------------------------- Production budget (optional)
# Analisis -> Data Profil -> Profil Blok, tab Produksi: budget per block from a database on the SAME server and account
# (data_budget.budget_produksi_harian), read in a read-only session. Empty = that budget column stays empty.
# e.g. DO_PIMS_REPORT. (The earlier name DOD_GIS_PRODUCTION_DB is still read.)
DOD_PRODUCTION_DB=

# ---------------------------------------------------------------- Data access (docs/DATA_ACCESS.md)
# Every report, table and dashboard is limited to the user's assignments (Settings -> Pengguna -> Akses data).
# Organization reference (PIMS dor_apims_master). Empty = the existing DOD account (DOD_DB_USER / DOD_DB_PASSWORD),
# which the database owner grants SELECT on the organization tables only (docs/sql/dor_apims_master/02_grant.sql).
# Never postgres. Without the grant, users without unrestricted_data get no report data (fail-closed).
DOD_ORG_DB_USER=
DOD_ORG_DB_PASSWORD=
# Defaults: DOD_DB_HOST / DOD_DB_PORT / DOD_DB_MASTER_NAME / DOD_DB_SSL.
DOD_ORG_DB_HOST=
DOD_ORG_DB_PORT=
DOD_ORG_DB_NAME=
DOD_ORG_DB_SSL=
# Fixed lifetime of the organization snapshot, 0-300 seconds (never extended; expired + unreachable = 503).
DOD_ORG_CACHE_SECONDS=300
# Level Region: ms_region (company.region_id) or so_region (SO nodes of structure REGION). Empty = level not usable.
DOD_ORG_REGION_SOURCE=
# Level Wilayah Administrasi: approved ms_so_node ids of the Director areas, comma separated. Empty = level not usable.
DOD_ORG_WILAYAH_NODE_IDS=
# Level GMK: approved ms_gmk_header ids, comma separated. Empty = level not usable.
DOD_ORG_GMK_HEADER_IDS=
# Special privilege unrestricted_data (usernames): unrestricted data access, independent of the role. Audited.
DOD_DATA_UNRESTRICTED_USERS=
# Data access managers (usernames): may change OTHER users' assignments (never their own).
DOD_DATA_ACCESS_MANAGERS=

# ---------------------------------------------------------------- Safety limits
DOD_QUERY_TIMEOUT_MS=30000
DOD_METADATA_TIMEOUT_MS=15000
DOD_RESULT_DEFAULT_LIMIT=3000
DOD_RESULT_MAX_LIMIT=20000
DOD_EXPORT_MAX_ROWS=50000
DOD_DISTINCT_VALUES_MAX=500
# Cached aggregated results (Analisis, reports), per dataset version + access scope; 0 = off
DOD_RESULT_CACHE_SECONDS=300
