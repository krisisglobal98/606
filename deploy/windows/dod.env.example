# DOD Minimal production configuration for Windows Server / IIS. Deploy-DOD.ps1 copies this to <Root>\config\dod.env
# (default D:\DODMinimal\config\dod.env) the first time and stops until it is filled. The file stays OUTSIDE the
# releases (an update never touches it) and only Administrators, SYSTEM and the service account may read it.
# Never commit real values. Full list of variables: deploy\windows\.env.example and docs/CONFIGURATION.md.
#
# Everything here is DOD Minimal's own: API port 8181 and database dod_application_sit. A full DOD installation on the same
# server (service DOD-API, D:\DOD, ports 8080/8090, database dor_application) is never used or touched.

NODE_ENV=production
DOD_LOG_LEVEL=info

# ---- DOD API: only IIS reaches it (the IIS site "DODMIN" proxies /api to it)
DOD_API_HOST=127.0.0.1
DOD_API_PORT=8181
# The address ARR connects from (IIS on this server: 127.0.0.1). Only the proxy, never a wide range.
DOD_TRUSTED_PROXIES=127.0.0.1

# ---- Application database (DOD Minimal's own; migrations run at API start)
DOD_DB_HOST=
DOD_DB_PORT=5432
DOD_DB_NAME=dod_application_sit
DOD_DB_USER=dodmin
DOD_DB_PASSWORD=
DOD_DB_SSL=false
# Optional, read-only, on the same server and account: organization master / production budget (Data Profil).
DOD_DB_MASTER_NAME=
DOD_PRODUCTION_DB=

# Only used when the user table is empty (a fresh database).
DOD_ADMIN_USERNAME=admin
DOD_ADMIN_PASSWORD=
DOD_SESSION_HOURS=8

# ---- Data access (docs/DATA_ACCESS.md). Empty user = the existing DOD account (DOD_DB_USER), granted SELECT on the
# organization tables by the database owner (docs/sql/dor_apims_master/02_grant.sql). Never postgres.
DOD_ORG_DB_USER=
DOD_ORG_DB_PASSWORD=
DOD_ORG_CACHE_SECONDS=300
# ms_region | so_region (empty = level Region not usable)
DOD_ORG_REGION_SOURCE=
# Approved ids (comma separated); empty = that level is not usable.
DOD_ORG_WILAYAH_NODE_IDS=
DOD_ORG_GMK_HEADER_IDS=
# Usernames: special privilege unrestricted_data / data access managers.
DOD_DATA_UNRESTRICTED_USERS=
DOD_DATA_ACCESS_MANAGERS=

# ---- Data warehouse sources: set ONLY here (no page in DOD). Read-only accounts; each needs its PASSWORD. Empty = none.
DOD_DW_CONNECTIONS=
# DOD_DW_DEV_NAME=APIMS REPORT DEV
# DOD_DW_DEV_TYPE=postgresql
# DOD_DW_DEV_HOST=
# DOD_DW_DEV_PORT=5432
# DOD_DW_DEV_DATABASE=APIMS_REPORT
# DOD_DW_DEV_USERNAME=
# DOD_DW_DEV_PASSWORD=
# DOD_DW_DEV_SCHEMA=public
# DOD_DW_DEV_SSL_MODE=require

# ---- Optional
